#Requires AutoHotkey v2.0
#SingleInstance Force
#Warn

Persistent
KeyHistory(500)   ; room to read back a few seconds of held keys after a glitch
SetTitleMatchMode(2)
SendMode("Input")
SetWorkingDir(A_ScriptDir)

global AppsIni := A_ScriptDir . "\apps.ini"
global SettingsIni := A_ScriptDir . "\settings.ini"
global LofreeScroll := ReadBool("features", "lofree_scroll", false)
global ScrollSteps := Max(1, IniRead(SettingsIni, "scroll", "steps", "7") + 0)
global ScrollDelayMs := Max(0, IniRead(SettingsIni, "scroll", "delay_ms", "4") + 0)
global TerminalModifierSwap := ReadBool("features", "terminal_modifier_swap", true)
global LCtrlAsWin := false   ; true while the held left Ctrl has turned into Win
global Leader := ""          ; the InputHook while wait mode is on
global LeaderStart := 0      ; A_TickCount of the tap that started it

; Processes that count as a terminal for the Cmd-style swap below. The macOS half
; of this repo uses Ghostty, which has no Windows build, so Windows Terminal is
; the terminal here. Add another process name to this map to cover another
; terminal app; the comparison is case-insensitive.
global TerminalProcesses := BuildTerminalProcesses()

RegisterAppHotkeys()
RegisterScrollHotkeys()
RegisterLCtrlAsWin()

; CapsLock and Escape swap. Both use the keyboard hook ($ and *), which ignores
; keystrokes the script sends itself, so neither re-triggers the other.
;
; Escape sends Caps Lock for Wispr Flow's push-to-talk, held as long as Escape
; is held, then turns Caps Lock back off on release so capitals never stick.
; With Wispr running it swallows the key and Caps Lock stays off, so
; SetCapsLockState sends nothing.
$CapsLock::Send("{Escape}")
*Escape::Send("{Blind}{CapsLock down}")
*Escape up:: {
    Send("{Blind}{CapsLock up}")
    SetCapsLockState(false)
}

; The right Command key on a Mac-style keyboard reports as Right Win on Windows.
; Remap it to Right Alt, which is what drives the >! app-switcher hotkeys below.
; A lone tap starts wait mode and a double tap opens Raycast (StartLeader); vkE8
; masks the Alt so no menu bar opens. This does not stop Right Win+L from locking the machine, so the Linear
; key needs the Win+L fix in README.md.
*RWin::Send("{Blind}{RAlt down}")
*RWin up:: {
    Send("{Blind}{vkE8}{RAlt up}")
    if A_PriorKey = "RWin"
        StartLeader()
}
; A keyboard with a real Right Alt gets the same lone-tap wait mode. The vkE8 on
; press keeps a lone tap from opening the app's menu bar.
~*RAlt::Send("{Blind}{vkE8}")
~*RAlt up:: {
    if A_PriorKey = "RAlt"
        StartLeader()
}
; A click ends wait mode, so a forgotten tap does not eat a later key.
~*LButton::StopLeader()
~*RButton::StopLeader()
~*MButton::StopLeader()

; macOS-style Command key, swapped with the left Ctrl key. On the Mac layout the
; Command key sits where the Windows key sits (right of Alt) and is the primary
; shortcut modifier: Cmd+C copies, Cmd+V pastes, and so on. So the left Win key
; sends Ctrl for every combo, and the left Ctrl key sends Win in return -- that
; keeps a real Windows key on the board (Start menu, Win+Tab, Win+arrow snapping,
; Win+Space search below) instead of losing it to the Cmd role. Alt is untouched,
; so opt=alt as on the Mac. Right Ctrl, and any other keyboard, still send a
; plain Ctrl.
;
; The left Ctrl key is not grabbed on its own. It goes out as plain Ctrl, and
; turns into Win only when the next key lands while Ctrl is physically held (see
; RegisterLCtrlAsWin), or on a lone tap (Start). Grabbing Ctrl itself held up
; other programs' injected Ctrl: Wispr Flow pastes with a fast Ctrl+V, and the
; "v" got through before the script had re-sent its Ctrl. At the moment a Ctrl
; press arrives the hook cannot yet tell physical from injected; by the time the
; next key arrives, GetKeyState("LCtrl", "P") can.
;
; Hotkeys ignore level-0 input generated by the script, so the LCtrl that
; LWin::LCtrl sends never reaches the left Ctrl handling below.
;
; Win+L is the one combo this cannot fix. Windows handles it below the keyboard
; hook, so a physical Win+L still locks the machine even though the app only ever
; sees Ctrl+L. Nothing in AutoHotkey can block it; see the Win+L section of
; README.md for the two registry options.
; Both keyboards (laptop: Ctrl Fn Win Alt, Lofree in Windows mode: Ctrl Win Alt)
; put Alt next to the space bar, where Cmd sits on a Mac. So the left Alt key is
; the Command key and sends Ctrl, and the left Win key takes over Alt. Cmd+L is
; then a physical Alt+L, so it never locks the machine.
LAlt::LCtrl
LWin::LAlt
~*LCtrl up::LCtrlRelease()

; Screen snip on Cmd+Shift+C. The Cmd key sends Ctrl, so it arrives as
; Ctrl+Shift+C. Off inside a terminal, where Ctrl+Shift+C is the app's copy.
#HotIf !TerminalActive()
^+c::Run("ms-screenclip:")
#HotIf

; Spotlight-style search on the Ctrl key. Ctrl now sends Win, so the keystroke
; arrives as Win+Space -- natively that cycles the input language, which is unused
; here. Send a real Win+S instead to open Windows Search. To point this at
; PowerToys Run instead, change the Send to "!{Space}".
#Space::Send("#s")

; ---------------------------------------------------------------------------
; Terminal modifier swap (features/terminal_modifier_swap)
;
; LAlt::LCtrl above makes the Cmd key behave like the Mac Command key everywhere, which
; is right for GUI apps but collides inside a terminal: on macOS, Cmd+W closes a
; tab while Ctrl+W deletes a word, and both arrive here as Ctrl+W. Windows
; Terminal puts its window/tab commands on Ctrl+Shift+<key>, so translate the
; Cmd-style press to that and let a real Ctrl press through unchanged.
;
; The two are told apart by physical key state: LAlt::LCtrl is a hook-based
; remap, so a physically held LAlt is still visible to GetKeyState(..., "P")
; even though the logical modifier reaching the app is Ctrl.
;
; Note the Ctrl side moved when the left Ctrl key became Win: the readline keys
; (Ctrl+W delete word, Ctrl+T transpose, Ctrl+F forward char) now need Right Ctrl,
; or another keyboard. Set terminal_modifier_swap=0 if the Cmd-style
; translations are more trouble than they are worth on this layout.
;
; That test lives in the #HotIf context rather than inside the handlers on
; purpose. With it there, a real Ctrl press leaves these hotkeys unarmed and the
; keystroke reaches the terminal natively. Handling the pass-through inside a
; handler instead would mean re-sending Ctrl+<key>, which AHK's own hook would
; catch as the same hotkey and loop forever -- the trap the CapsLock block above
; works around. The replacements are safe to send because a Ctrl+Shift+<key>
; hotkey does not fire on the plain Ctrl+<key> variants below.
;
; Copy and paste are deliberately absent. Windows Terminal is configured with
; Ctrl+C as copy and Ctrl+V as paste, and its copy action falls through to the
; shell when there is no selection, so Cmd+C copies and a bare Ctrl+C still
; sends SIGINT without any swap here.
; ---------------------------------------------------------------------------
#HotIf TerminalActive() && GetKeyState("LAlt", "P")
^t::Send("^+t")        ; Cmd+T -> new tab
^w::Send("^+w")        ; Cmd+W -> close pane/tab
^n::Send("^+n")        ; Cmd+N -> new window
^f::Send("^+f")        ; Cmd+F -> find
#HotIf

; Every key below fires only while the left Ctrl key is physically held, so an
; injected Ctrl+V from another program passes straight through. The first such
; key releases Ctrl and holds Win in its place until Ctrl is released.
RegisterLCtrlAsWin() {
    keys := ["Tab", "Space", "Enter", "Backspace", "Delete", "Insert", "Home", "End"
        , "PgUp", "PgDn", "Left", "Right", "Up", "Down", "PrintScreen", "Pause"
        ; - = [ ] ; ' ` \ , . / by scan code, so the layout does not matter
        , "sc00C", "sc00D", "sc01A", "sc01B", "sc027", "sc028", "sc029", "sc02B"
        , "sc033", "sc034", "sc035"]
    Loop Parse, "abcdefghijklmnopqrstuvwxyz0123456789"
        keys.Push(A_LoopField)
    Loop 12
        keys.Push("F" A_Index)

    HotIf((*) => GetKeyState("LCtrl", "P"))
    for key in keys
        Hotkey("*" key, LCtrlAsWinKey.Bind(key))
    HotIf()
}

LCtrlAsWinKey(key, *) {
    global LCtrlAsWin
    if !LCtrlAsWin {
        LCtrlAsWin := true
        Send("{Blind}{LCtrl up}{LWin down}")
    }
    ; Win+Space cycles the input language; Win+S opens Windows Search.
    Send("{Blind}{" (key = "Space" ? "s" : key) "}")
}

; A lone tap of the left Ctrl key opens Start, as a Win tap would.
LCtrlRelease() {
    global LCtrlAsWin
    if LCtrlAsWin {
        LCtrlAsWin := false
        Send("{Blind}{LWin up}")
    } else if A_PriorKey = "LControl"
        Send("{LWin}")
}

BuildTerminalProcesses() {
    processes := Map()
    processes.CaseSense := false
    for name in ["WindowsTerminal.exe", "wt.exe", "OpenConsole.exe"]
        processes[name] := true
    return processes
}

TerminalActive() {
    global TerminalModifierSwap, TerminalProcesses
    if !TerminalModifierSwap
        return false
    try
        return TerminalProcesses.Has(WinGetProcessName("A"))
    catch
        return false
}

ReadBool(section, key, defaultValue) {
    global SettingsIni
    fallback := defaultValue ? "1" : "0"
    value := StrLower(Trim(IniRead(SettingsIni, section, key, fallback)))
    return value = "1" || value = "true" || value = "yes" || value = "on"
}

RegisterAppHotkeys() {
    ; Right Alt is the app-switcher trigger: it sits where the Mac right
    ; Command key does, so Right Alt+key mirrors the macOS "rcmd" switcher.
    Hotkey(">!Enter", SwitchToPreviousApp)
    Hotkey(">!+Enter", SwitchToPreviousApp)

    Loop 9 {
        Hotkey(">!" . A_Index, JumpToTab.Bind(A_Index))
        Hotkey(">!+" . A_Index, JumpToTab.Bind(A_Index))
    }

    Loop Parse, "abcdefghijklmnopqrstuvwxyz" {
        key := A_LoopField
        Hotkey(">!" . key, SwitchMappedApp.Bind(key))
        Hotkey(">!+" . key, SwitchMappedApp.Bind(key))
    }
    ; V opens Raycast's clipboard history instead of an app.
    Hotkey(">!v", OpenClipboardHistory)
    Hotkey(">!+v", OpenClipboardHistory)
}

OpenClipboardHistory(*) {
    Run("raycast://extensions/raycast/clipboard-history/clipboard-history")
}

; Wait mode: a lone Right Alt tap waits for the next key, with no time limit,
; and runs it as Right Alt+key. A key with no action, Escape, a click or a
; second tap ends it, and the key is dropped. A key pressed with Ctrl, Alt or
; Win goes through, so Ctrl+C still copies. A second tap within 400 ms opens
; Raycast.
;
; The hook suppresses every key until the callback has read it, so a fast key
; never reaches the app first.
StartLeader() {
    global Leader, LeaderStart
    if Leader {
        quick := A_TickCount - LeaderStart < 400
        StopLeader()
        if quick
            Run("raycast://")
        return
    }
    ih := InputHook("L0")
    ih.KeyOpt("{All}", "NS")
    ih.KeyOpt("{LShift}{RShift}{LCtrl}{RCtrl}{LAlt}{RAlt}{LWin}{RWin}", "-N-S")
    ih.OnKeyDown := LeaderKey
    Leader := ih
    LeaderStart := A_TickCount
    ih.Start()
}

StopLeader(*) {
    global Leader
    if !Leader
        return
    ih := Leader
    Leader := ""
    ih.Stop()
}

LeaderKey(ih, vk, sc) {
    global Leader
    keyName := Format("vk{:X}sc{:03X}", vk, sc)
    ; The hook held this key before the wait ended, so it belongs to the app.
    if Leader != ih
        return Send("{Blind}{" . keyName . "}")
    StopLeader()
    if GetKeyState("Ctrl") || GetKeyState("LAlt") || GetKeyState("LWin") || GetKeyState("RWin")
        return Send("{Blind}{" . keyName . "}")
    if sc = 0x1C                                     ; Enter
        return SwitchToPreviousApp()
    if sc = 0x2F                                     ; V
        return OpenClipboardHistory()
    if sc >= 0x02 && sc <= 0x0A                      ; 1-9 on the top row
        return JumpToTab(sc - 1)
    key := StrLower(GetKeyName(keyName))
    if RegExMatch(key, "^[a-z]$") && ReadApp(key)
        SwitchMappedApp(key)
}

; Right Alt+1-9 brings Brave (the "a" app) to the front on tab N; 9 is the
; last tab. It never cycles Brave windows, so the tab lands in the window in use.
JumpToTab(n, *) {
    app := ReadApp("a")
    if !app
        return
    if !WinActive(app.Criteria) {
        hwnd := WinExist(app.Criteria)
        if !hwnd
            return SwitchMappedApp("a")
        if WinGetMinMax(hwnd) = -1
            WinRestore(hwnd)
        WinActivate(hwnd)
        if !WinWaitActive(hwnd, , 1)
            return
    }
    Send("^" . n)
}

ReadApp(key) {
    global AppsIni
    raw := IniRead(AppsIni, "apps", key, "")
    if raw = ""
        return false

    parts := StrSplit(raw, "|")
    if parts.Length < 3
        return false

    return {
        Name: Trim(parts[1]),
        Criteria: Trim(parts[2]),
        Command: ExpandEnv(Trim(parts[3]))
    }
}

ExpandEnv(text) {
    size := DllCall("ExpandEnvironmentStrings", "Str", text, "Ptr", 0, "UInt", 0)
    buf := Buffer(size * 2)
    DllCall("ExpandEnvironmentStrings", "Str", text, "Ptr", buf, "UInt", size)
    return StrGet(buf)
}

; An unmapped key does nothing.
SwitchMappedApp(key, *) {
    app := ReadApp(key)
    if !app
        return
    if app.Criteria = "" {
        Notify("No window criteria configured for " . app.Name)
        return
    }

    try windows := WinGetList(app.Criteria)
    catch Error as err {
        Notify("Invalid window criteria for " . app.Name . ": " . err.Message)
        return
    }
    if windows.Length {
        CycleWindows(windows)
        return
    }

    if app.Command = "" {
        Notify("No launch command configured for " . app.Name)
        return
    }

    try {
        Run(app.Command)
        hwnd := WinWait(app.Criteria, , 15)
        if hwnd
            WinActivate(hwnd)
        else
            Notify("Started " . app.Name . ", but no matching window appeared")
    } catch Error as err {
        Notify("Could not start " . app.Name . ": " . err.Message)
    }
}

CycleWindows(windows) {
    active := WinExist("A")
    target := windows[1]

    for index, hwnd in windows {
        if hwnd = active {
            target := windows[index = windows.Length ? 1 : index + 1]
            break
        }
    }

    try {
        if WinGetMinMax(target) = -1
            WinRestore(target)
        WinActivate(target)
    }
}

; Right Alt+0 focuses the topmost Alt+Tab window of another app. WinGetList
; returns windows in z-order, so that is the app used last before this one.
SwitchToPreviousApp(*) {
    active := WinExist("A")
    try activeProcess := WinGetProcessName(active)
    catch
        activeProcess := ""
    for hwnd in WinGetList() {
        if hwnd = active || !IsAltTabWindow(hwnd)
            continue
        try {
            if WinGetProcessName(hwnd) = activeProcess
                continue
            if WinGetMinMax(hwnd) = -1
                WinRestore(hwnd)
            WinActivate(hwnd)
            return
        }
    }
    Notify("No previous app")
}

IsAltTabWindow(hwnd) {
    try {
        if WinGetTitle(hwnd) = "" || DllCall("GetWindow", "Ptr", hwnd, "UInt", 4, "Ptr")
            return false
        if WinGetExStyle(hwnd) & 0x80        ; WS_EX_TOOLWINDOW
            return false
        cloaked := 0
        DllCall("dwmapi\DwmGetWindowAttribute", "Ptr", hwnd, "UInt", 14, "UInt*", &cloaked, "UInt", 4)
        return !cloaked && WinGetClass(hwnd) != "Progman"
    }
    return false
}

RegisterScrollHotkeys() {
    global LofreeScroll, SettingsIni
    if !LofreeScroll
        return

    totalDelta := Abs(IniRead(SettingsIni, "scroll", "delta", "72") + 0)
    if totalDelta = 0
        return

    for keyName in StrSplit(IniRead(SettingsIni, "scroll", "up_hotkeys", "Volume_Up"), ",") {
        keyName := Trim(keyName)
        if keyName != ""
            Hotkey(keyName, SmoothScroll.Bind(-totalDelta))
    }
    for keyName in StrSplit(IniRead(SettingsIni, "scroll", "down_hotkeys", "Volume_Down"), ",") {
        keyName := Trim(keyName)
        if keyName != ""
            Hotkey(keyName, SmoothScroll.Bind(totalDelta))
    }
}

SmoothScroll(totalDelta, *) {
    global ScrollSteps, ScrollDelayMs
    sign := totalDelta >= 0 ? 1 : -1
    magnitude := Abs(totalDelta)
    frameCount := Max(1, Min(ScrollSteps, magnitude))
    baseDelta := magnitude // frameCount
    remainder := Mod(magnitude, frameCount)

    Loop frameCount {
        stepMagnitude := baseDelta + (A_Index <= remainder ? 1 : 0)
        stepDelta := stepMagnitude * sign
        DllCall(
            "user32\mouse_event",
            "UInt", 0x0800,
            "UInt", 0,
            "UInt", 0,
            "Int", stepDelta,
            "UPtr", 0
        )
        if A_Index < frameCount && ScrollDelayMs > 0
            Sleep(ScrollDelayMs)
    }
}

Notify(message) {
    ToolTip(message)
    SetTimer(() => ToolTip(), -2500)
}
