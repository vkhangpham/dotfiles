# Editor used by CLI + helpers
export EDITOR="nvim"
export VISUAL="$EDITOR"
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Match Omarchy path helpers where possible
export OMARCHY_PATH="$HOME/.local/share/omarchy"
export PATH="$OMARCHY_PATH/bin:$PATH:$HOME/.local/bin"

# Bun installs outside the standard system paths on macOS.
if [[ -d "$HOME/.bun/bin" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

# macOS/Homebrew fallbacks
[[ -d /usr/local/bin ]] && export PATH="/usr/local/bin:$PATH"
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"

# Prefer sharp prebuilt binaries over Homebrew libvips source builds.
export SHARP_IGNORE_GLOBAL_LIBVIPS=1

# Optional local secrets. Keep values out of the repo.
if [[ -f "$HOME/.credentials/.env" ]]; then
  setopt allexport
  source "$HOME/.credentials/.env"
  unsetopt allexport
fi

# The GitHub MCP server sends "Bearer $GITHUB_PERSONAL_ACCESS_TOKEN" verbatim, so
# an empty value yields a malformed header and a 400 rather than a clean auth
# error. Fall back to the gh CLI keyring, which never goes stale and keeps the
# token out of both this repo and ~/.credentials/.env.
if [[ -z "$GITHUB_PERSONAL_ACCESS_TOKEN" ]] && command -v gh >/dev/null 2>&1; then
  GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token 2>/dev/null)"
  [[ -n "$GITHUB_PERSONAL_ACCESS_TOKEN" ]] && export GITHUB_PERSONAL_ACCESS_TOKEN
fi

# Make common secret env vars available to GUI apps on macOS when present.
if [[ "$OSTYPE" == darwin* ]] && command -v launchctl >/dev/null 2>&1; then
  typeset -a gui_env_vars=(
    ANTHROPIC_API_KEY
    ANTHROPIC_AUTH_TOKEN
    OPENAI_API_KEY
    OPENROUTER_API_KEY
    GLM_API_KEY
    MINIMAX_API_KEY
    GITHUB_PERSONAL_ACCESS_TOKEN
  )
  for var_name in $gui_env_vars; do
    if [[ -n "${(P)var_name}" ]]; then
      launchctl setenv "$var_name" "${(P)var_name}" >/dev/null 2>&1 || true
    fi
  done
fi
