README.md
docs

{{ if ne .chezmoi.os "darwin" }}
# macOS-only: Karabiner stack and its helpers
.config/karabiner
.config/karabiner-rcmd
.local/bin/karabiner-rcmd-map
.local/bin/karabiner-rcmd-switch
.local/src/karabiner-scroll-helper
{{ end }}

{{ if ne .chezmoi.os "windows" }}
# Windows-only: AutoHotkey keymaps (applied manually on Windows anyway)
.config/autohotkey
{{ end }}

{{ $wsl := and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}

{{ if or (ne .chezmoi.os "linux") $wsl }}
# Omarchy desktop stack: bare-metal Linux only.
# Hyprland/Waybar/Walker and the Omarchy Bash tree have no meaning on macOS,
# Windows, or WSL, so they must not land in $HOME there.
.config/hypr
.config/waybar
.config/walker
.config/omarchy
.local/share/omarchy
{{ end }}

{{ if $wsl }}
# WSL: the terminal lives on the Windows side, so Ghostty config is unused.
# (macOS still gets Ghostty through the OS-aware template.)
.config/ghostty
{{ end }}
